load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "ti",
    srcs = ["ti_main.cc"],
    deps = ["//tianshu"],
)

cc_binary(
    name = "ti-launch",
    srcs = ["ti_launch_main.cc"],
    # -rdynamic: unify the registry's inline static-local head with
    # dlopened providers' copies (same rationale as the CMake side).
    linkopts = ["-rdynamic"],
    deps = [
        "//tianshu",
        "//tianshu:tianshu_compiler",
    ],
)

cc_binary(
    name = "ti-monitor",
    srcs = ["ti_monitor_main.cc"],
    deps = ["//tianshu"],
)

cc_binary(
    name = "ti-info",
    srcs = ["ti_info_main.cc"],
    deps = ["//tianshu"],
)

cc_binary(
    name = "ti-compile",
    srcs = ["ti_compile_main.cc"],
    # -rdynamic: unify the registry's inline static-local head with
    # dlopened providers' copies (same rationale as the CMake side).
    linkopts = ["-rdynamic"],
    deps = [
        "//tianshu",
        "//tianshu:tianshu_compiler",
    ],
)
