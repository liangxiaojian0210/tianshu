[4.579215, "o", "// Generated by the tianshu L1 pipeline (ADR-0030). Do not edit.\r\n// flow: demo_traceable  hash: 9a441609d42f3034\r\n// install: specialized per-message wiring (ADR-0032); the plan\r\n// (fast/generic channel classification, history capture) is derived\r\n// from the flow at begin_specialize() time.\r\n// topology (canonical order):\r\n//   0  source -> demo_traceable/ticks\r\n//   1  map demo_traceable/ticks -> demo_traceable/~0\r\n//   2  sink demo_traceable/~0\r\n\r\n#include \"tianshu/dsl/dsl_runtime.h\"\r\n\r\nextern \"C\" const char* tianshu_flow_hash() { return \"9a441609d42f3034\"; }\r\n\r\nextern \"C\" void tianshu_flow_install(tianshu::dsl::FlowRuntime* rt,\r\n                                     const tianshu::dsl::Flow* flow) {\r\n"]
[4.579241, "o", "  tianshu::dsl::SpecializeBuilder plan = rt->begin_specialize(*flow);\r\n  if (flow->maps()[0].specialize) {\r\n    flow->maps()[0].specialize(*rt, plan);\r\n  } else {\r\n    flow->maps()[0].wire(*rt);\r\n  }\r\n  if (flow->sinks()[0].specialize) {\r\n    flow->sinks()[0].specialize(*rt, plan);\r\n  } else {\r\n    flow->sinks()[0].wire(*rt);\r\n  }\r\n  plan.finalize();\r\n}\r\n"]
